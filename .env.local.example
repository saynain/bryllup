# Google Sheets Integration
# Get these values from your Google Cloud Service Account JSON file

# The email from the service account (looks like: project-name@project-id.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# The private key from the service account JSON file (copy the entire key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Your Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEET_ID=YOUR_SHEET_ID_HERE

# Photo Storage Configuration
# Choose either 'vercel-blob' or 'google-drive'
STORAGE_PROVIDER=vercel-blob

# Vercel Blob (if using vercel-blob provider)
# Get this from Vercel Dashboard → Storage → Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Google Drive (if using google-drive provider)
# Create a shared folder and get its ID from the URL
GOOGLE_DRIVE_FOLDER_ID=YOUR_FOLDER_ID_HERE

# Site URL for QR codes
NEXT_PUBLIC_SITE_URL=https://bryllup.rylands.no

# Cloudflare media upload API
# Keep the main site on Vercel, but send /photos gallery and uploads to this Worker.
# Leave empty to use the legacy Vercel Blob /api/photos flow.
NEXT_PUBLIC_MEDIA_API_URL=https://bryllup-media.saynain.workers.dev

# Optional separate endpoint for the protected album administration UI.
# Test deployments default to the read-only staging Worker when this is empty.
NEXT_PUBLIC_MEDIA_ADMIN_API_URL=

# Optional. Only set this if the Worker has the matching UPLOAD_TOKEN secret.
# This is not strong authentication when exposed to the browser, but it prevents
# accidental anonymous uploads from clients that do not know the event URL/token.
NEXT_PUBLIC_MEDIA_UPLOAD_TOKEN=

# Wedding gift section
NEXT_PUBLIC_HONEYMOON_ACCOUNT=1234.56.78910
NEXT_PUBLIC_WISHLIST_URL=https://onsk.no/lister/din-onskeliste
NEXT_PUBLIC_VIPPS_NUMBER=90016157
